<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

	<!-- Force x64 build since DLL is 64-bit -->
	<PlatformTarget>x64</PlatformTarget>
	<ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

	<!-- Copy native DLLs from libs folder to output -->
	<ItemGroup>
		<None Update="Libs\*.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<Link>%(Filename)%(Extension)</Link>
		</None>
	</ItemGroup>
	
  <ItemGroup>
    <None Remove="Assets\AppIcon.ico" />
    <None Remove="Assets\arrow.png" />
    <None Remove="Assets\bg.png" />
    <None Remove="Assets\groupimage.png" />
    <None Remove="Assets\KuboMediaFavIcon.ico" />
    <None Remove="Assets\leftside.png" />
    <None Remove="Assets\leftside2.png" />
    <None Remove="Assets\logo.png" />
    <None Remove="Assets\logout.png" />
    <None Remove="Assets\Maintenance.png" />
    <None Remove="Assets\MaintenancePopup.png" />
    <None Remove="Assets\PrintError.png" />
    <None Remove="Assets\PrintingError.png" />
    <None Remove="Assets\printprogress.mp4" />
    <None Remove="Assets\printsuccess.mp4" />
    <None Remove="Assets\qr.png" />
    <None Remove="Assets\qrborder.png" />
    <None Remove="Assets\qrborder2.png" />
    <None Remove="Assets\rightside.png" />
    <None Remove="Assets\rightside2.png" />
    <None Remove="Assets\Star.png" />
    <None Remove="Assets\UnderMaintenance.png" />
    <None Remove="Fonts\Poppins\OFL.txt" />
    <None Remove="Fonts\Poppins\Poppins-Bold.ttf" />
    <None Remove="Fonts\Poppins\Poppins-Medium.ttf" />
    <None Remove="Fonts\Poppins\Poppins-Regular.ttf" />
    <None Remove="Fonts\Poppins\Poppins-SemiBold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\arrow.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\bg.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\groupimage.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\KuboMediaFavIcon.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\leftside.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\leftside2.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\logo.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\CoverVideo.mp4">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\printprogress.mp4">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
