    </Resource>
    <Resource Include="Fonts\Poppins\Poppins-SemiBold.ttf">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Libs\dcrf32.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Libs\dcrf32.dll" Link="Libs\dcrf32.dll" />
    <None Update="Libs\SeaorySDK.dll" Link="Libs\SeaorySDK.dll" />
    <None Update="Libs\SeaorySDK.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
