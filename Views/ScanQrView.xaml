<Page x:Class="kuboPix.Views.ScanQrView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="1920" d:DesignWidth="1080"
      Background="#FFFFFF"
      FontFamily="Poppins, Segoe UI"
      Title="Scan QR">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Header (Logo) -->
            <RowDefinition Height="*"/>    <!-- Row 1: QR Section (Middle) -->
            <RowDefinition Height="Auto"/> <!-- Row 2: Cancel Button -->
        </Grid.RowDefinitions>

        <!-- ===== 1. HEADER (Logo + Tagline) ===== -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Top"
                    Margin="0,120,0,0"
                    HorizontalAlignment="Center">
            <!-- Logo -->
            <Image Source="/Assets/logo.png"
                   Width="240"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Tagline -->
            <TextBlock Text="I N S T A N T   P H O T O   K I O S K" 
                       FontFamily="Poppins" 
                       FontWeight="Bold" 
                       FontSize="15" 
                       Foreground="#FF1C244B" 
                       HorizontalAlignment="Center" 
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- ===== 2. CENTER CONTENT (Title + Large QR + Instructions) ===== -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,20">

            <!-- Scan Title -->
            <TextBlock Text="Scan to Upload"
                       FontFamily="Poppins"
                       FontWeight="SemiBold"
                       FontSize="34"
                       Foreground="#FF333333"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,45"/>

            <!-- Large QR Code with Border Frame -->
            <Border BorderBrush="#DCDCDC"
                    BorderThickness="1.5"
                    CornerRadius="6"
                    Padding="22"
                    Background="White"
                    HorizontalAlignment="Center">
                <Image x:Name="qrDynamicImage1"
                       Width="500"
                       Height="500"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <!-- Instructions with Increased Font Size -->
            <StackPanel HorizontalAlignment="Center"
                        Margin="0,48,0,0">
                <TextBlock Text="1. Open Camera on your phone"
                           FontFamily="Poppins"
                           FontSize="24"
                           Foreground="#FF555555"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>

                <TextBlock Text="2. Scan the code above"
                           FontFamily="Poppins"
                           FontSize="24"
                           Foreground="#FF555555"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>

                <TextBlock Text="3. Select the photo you want to print"
                           FontFamily="Poppins"
                           FontSize="24"
                           Foreground="#FF555555"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- ===== 3. CANCEL BUTTON ===== -->
        <Button Grid.Row="2"
                x:Name="btnCancel"
                Width="520"
                Height="72"
                HorizontalAlignment="Center"
                Margin="0,0,0,70"
                Click="Cancel_Click"
                Background="#FFEFEFEF"
                BorderThickness="0"
                Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="16">
                        <TextBlock Text="Cancel" 
                                   FontFamily="Poppins" 
                                   FontWeight="Medium" 
                                   FontSize="24" 
                                   Foreground="#FF4B5563" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.70"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Hidden Controls for Session / Status logic -->
        <Grid Grid.Row="0" Visibility="Collapsed">
            <StackPanel x:Name="priceText">
                <TextBlock x:Name="priceValueText"/>
                <TextBlock x:Name="priceCurrencyText"/>
            </StackPanel>

            <Image x:Name="starImage"/>

            <Border x:Name="PrinterStatusBorder">
                <StackPanel>
                    <Ellipse x:Name="PrinterStatusLight"
                             Width="12"
                             Height="12"/>
                    <TextBlock x:Name="PrinterStatusText"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Page>
