<Page x:Class="kuboPix.Views.Checkout"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:kuboPix.Views"
      mc:Ignorable="d" 
      d:DesignHeight="1920" d:DesignWidth="1080"
      Background="#FFFFFF"
      FontFamily="Poppins, Segoe UI"
      Title="Checkout"
      Unloaded="Page_Unloaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Header (Logo) -->
            <RowDefinition Height="*"/>    <!-- Row 1: Stepper + QR Content (Middle) -->
            <RowDefinition Height="Auto"/> <!-- Row 2: Cancel Button -->
        </Grid.RowDefinitions>

        <!-- ===== 1. HEADER (Logo + Tagline) ===== -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Top"
                    Margin="0,95,0,0"
                    HorizontalAlignment="Center">
            <!-- Logo -->
            <Image Source="/Assets/logo.png" 
                   Width="240" 
                   Stretch="Uniform" 
                   HorizontalAlignment="Center" 
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Tagline -->
            <TextBlock Text="I N S T A N T   P H O T O   K I O S K" 
                       FontFamily="Poppins" 
                       FontWeight="Bold" 
                       FontSize="15" 
                       Foreground="#FF1C244B" 
                       HorizontalAlignment="Center" 
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- ===== 2. MIDDLE CONTENT (Stepper + Scan to Pay QR Section) ===== -->
        <Grid Grid.Row="1"
              HorizontalAlignment="Center"
              Width="880"
              Margin="0,40,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Stepper Progress Indicator -->
                <RowDefinition Height="*"/>    <!-- Center QR Content -->
            </Grid.RowDefinitions>

            <!-- Stepper Progress Indicator (Preserved & Maintained) -->
            <Grid Grid.Row="0" Height="90" HorizontalAlignment="Center" Margin="0,0,0,30" Width="880">
                <!-- Connector Track Line behind circles -->
                <Grid Height="2" Margin="95,28,95,0" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#FF1C244B"/>
                    <Border Grid.Column="1" Background="#FF1C244B"/>
                    <Border Grid.Column="2" Background="#FFE5E7EB"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/> <!-- Step 1: Capture -->
                        <ColumnDefinition Width="*"/> <!-- Step 2: Edit -->
                        <ColumnDefinition Width="*"/> <!-- Step 3: Payment -->
                        <ColumnDefinition Width="*"/> <!-- Step 4: Print -->
                    </Grid.ColumnDefinitions>

                    <!-- Step 1: Capture (Completed with Tick) -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <Grid Width="56" Height="56">
                            <Ellipse Fill="#FF1C244B" Width="56" Height="56"/>
                            <Path Data="M 20,28 L 26,34 L 38,22" Stroke="White" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </Grid>
                        <TextBlock Text="Capture" 
                                   FontFamily="Poppins" 
                                   FontWeight="SemiBold" 
                                   FontSize="15" 
                                   Foreground="#FF1C244B" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Step 2: Edit (Completed with Tick) -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <Grid Width="56" Height="56">
                            <Ellipse Fill="#FF1C244B" Width="56" Height="56"/>
                            <Path Data="M 20,28 L 26,34 L 38,22" Stroke="White" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </Grid>
                        <TextBlock Text="Edit" 
                                   FontFamily="Poppins" 
                                   FontWeight="SemiBold" 
                                   FontSize="15" 
                                   Foreground="#FF1C244B" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Step 3: Payment (Active) -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <Ellipse Stroke="#FF1C244B" StrokeThickness="2.5" Fill="White" Width="56" Height="56"/>
                        <TextBlock Text="Payment" 
                                   FontFamily="Poppins" 
                                   FontWeight="SemiBold" 
                                   FontSize="15" 
                                   Foreground="#FF1C244B" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Step 4: Print (Inactive) -->
                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <Ellipse Stroke="#FFE5E7EB" StrokeThickness="2.5" Fill="White" Width="56" Height="56"/>
                        <TextBlock Text="Print" 
                                   FontFamily="Poppins" 
                                   FontSize="15" 
                                   Foreground="#FFA0A0AA" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Center Content (Scan to Pay + QR + Instructions) -->
            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <!-- Title: Scan to Pay -->
                <TextBlock Text="Scan to Pay" 
                           FontFamily="Poppins" 
                           FontWeight="SemiBold" 
                           FontSize="34" 
                           Foreground="#FF333333" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,16"/>

                <!-- Price / Amount Display -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <TextBlock Text="Total: " 
                               FontFamily="Poppins" 
                               FontWeight="SemiBold" 
                               FontSize="24" 
                               Foreground="#FF555555" 
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtAmount" 
                               Text="--.--" 
                               FontFamily="Poppins" 
                               FontWeight="Bold" 
                               FontSize="28" 
                               Foreground="#FF1C244B" 
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCurrency" 
                               Text=" CHF" 
                               FontFamily="Poppins" 
                               FontWeight="Bold" 
                               FontSize="22" 
                               Foreground="#FF1C244B" 
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- QR Code Box (Matching Scan to Upload frame) -->
                <Grid HorizontalAlignment="Center">
                    <Border BorderBrush="#DCDCDC" 
                            BorderThickness="1.5" 
                            CornerRadius="8" 
                            Padding="22" 
                            Background="White" 
                            HorizontalAlignment="Center">
                        <Image x:Name="ImgQrCode" 
                               Width="480" 
                               Height="480" 
                               Stretch="Uniform" 
                               HorizontalAlignment="Center" 
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!-- Loading / Initializing Overlay -->
                    <Grid x:Name="LoadingOverlay" 
                          Background="White" 
                          Visibility="Visible">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtLoadingTitle"
                                       Text="Generating Payment QR..." 
                                       FontFamily="Poppins" 
                                       FontWeight="SemiBold" 
                                       FontSize="24" 
                                       Foreground="#FF333333" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtLoadingSubtitle"
                                       Text="Connecting to payment server..." 
                                       FontFamily="Poppins" 
                                       FontSize="16" 
                                       Foreground="#FF888888" 
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Instructions (Matching Scan to Upload 3-step style) -->
                <StackPanel HorizontalAlignment="Center" Margin="0,32,0,0">
                    <TextBlock Text="1. Open Camera on your phone" 
                               FontFamily="Poppins" 
                               FontSize="22" 
                               Foreground="#FF555555" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,8"/>

                    <TextBlock Text="2. Scan the code above" 
                               FontFamily="Poppins" 
                               FontSize="22" 
                               Foreground="#FF555555" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,8"/>

                    <TextBlock Text="3. Complete the payment to print" 
                               FontFamily="Poppins" 
                               FontSize="22" 
                               Foreground="#FF555555" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,18"/>

                    <!-- Countdown Timer -->
                    <TextBlock x:Name="TxtCountdownTimer" 
                               Text="Expires in: 10:00" 
                               FontFamily="Poppins" 
                               FontWeight="Medium"
                               FontSize="22" 
                               Foreground="#FF6B7280" 
                               HorizontalAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </Grid>

        <!-- ===== 3. CANCEL BUTTON (Matching ScanQrView style) ===== -->
        <Button Grid.Row="2"
                x:Name="BackButton"
                Width="520"
                Height="72"
                HorizontalAlignment="Center"
                Margin="0,0,0,70"
                Click="BackButton_Click"
                Background="#FFEFEFEF"
                BorderThickness="0"
                Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="16">
                        <TextBlock Text="Cancel" 
                                   FontFamily="Poppins" 
                                   FontWeight="Medium" 
                                   FontSize="24" 
                                   Foreground="#FF4B5563" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.70"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

    </Grid>
</Page>
