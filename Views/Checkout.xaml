<Page x:Class="kuboPix.Views.Checkout"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:kuboPix.Views"
      mc:Ignorable="d" 
      d:DesignHeight="1920" d:DesignWidth="1080"
      Background="#FFFFFF"
      FontFamily="Poppins, Segoe UI"
      Title="Checkout">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Logo/Header -->
            <RowDefinition Height="*"/>    <!-- Stepper + Payment Options -->
            <RowDefinition Height="Auto"/> <!-- Bottom Buttons -->
        </Grid.RowDefinitions>

        <!-- ===== 1. HEADER (Logo + Tagline) ===== -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Top"
                    Margin="0,95,0,0"
                    HorizontalAlignment="Center">
            <!-- Logo -->
            <Image Source="/Assets/logo.png" 
                   Width="240" 
                   Stretch="Uniform" 
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Tagline -->
            <TextBlock Text="I N S T A N T   P H O T O   K I O S K" 
                       FontFamily="Poppins" 
                       FontWeight="Bold" 
                       FontSize="15" 
                       Foreground="#FF1C244B" 
                       HorizontalAlignment="Center" 
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- ===== 2. MIDDLE CONTENT (Stepper + Payment Options) ===== -->
        <Grid Grid.Row="1"
              Margin="0,80,0,40"
              HorizontalAlignment="Center"
              Width="880">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Stepper -->
                <RowDefinition Height="Auto"/> <!-- Title -->
                <RowDefinition Height="*"/>    <!-- Payment Cards Stack -->
            </Grid.RowDefinitions>

            <!-- Stepper Progress Indicator (880px width, matching Camera/Edit/PrintPreview) -->
            <Grid Grid.Row="0" Height="90" HorizontalAlignment="Center" Margin="0,0,0,78" Width="880">
                <!-- Connector Track Line behind circles -->
                <Grid Height="2" Margin="95,28,95,0" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#FF1C244B"/>
                    <Border Grid.Column="1" Background="#FF1C244B"/>
                    <Border Grid.Column="2" Background="#FFE5E7EB"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/> <!-- Step 1: Capture -->
                        <ColumnDefinition Width="*"/> <!-- Step 2: Edit -->
                        <ColumnDefinition Width="*"/> <!-- Step 3: Payment -->
                        <ColumnDefinition Width="*"/> <!-- Step 4: Print -->
                    </Grid.ColumnDefinitions>

                    <!-- Step 1: Capture (Completed with Tick) -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <Grid Width="56" Height="56">
                            <Ellipse Fill="#FF1C244B" Width="56" Height="56"/>
                            <Path Data="M 20,28 L 26,34 L 38,22" Stroke="White" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </Grid>
                        <TextBlock Text="Capture" 
                                   FontFamily="Poppins" 
                                   FontWeight="SemiBold" 
                                   FontSize="15" 
                                   Foreground="#FF1C244B" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Step 2: Edit (Completed with Tick) -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <Grid Width="56" Height="56">
                            <Ellipse Fill="#FF1C244B" Width="56" Height="56"/>
                            <Path Data="M 20,28 L 26,34 L 38,22" Stroke="White" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </Grid>
                        <TextBlock Text="Edit" 
                                   FontFamily="Poppins" 
                                   FontWeight="SemiBold" 
                                   FontSize="15" 
                                   Foreground="#FF1C244B" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Step 3: Payment (Active) -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <Ellipse Stroke="#FF1C244B" StrokeThickness="2.5" Fill="White" Width="56" Height="56"/>
                        <TextBlock Text="Payment" 
                                   FontFamily="Poppins" 
                                   FontWeight="SemiBold" 
                                   FontSize="15" 
                                   Foreground="#FF1C244B" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Step 4: Print (Inactive) -->
                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <Ellipse Stroke="#FFE5E7EB" StrokeThickness="2.5" Fill="White" Width="56" Height="56"/>
                        <TextBlock Text="Print" 
                                   FontFamily="Poppins" 
                                   FontSize="15" 
                                   Foreground="#FFA0A0AA" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Page Title positioned directly below Stepper -->
            <TextBlock Grid.Row="1" 
                       Text="Choose a Payment Method" 
                       FontFamily="Poppins" 
                       FontWeight="Bold" 
                       FontSize="36" 
                       Foreground="#FF1C244B" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,45"/>

            <!-- Payment Options Container positioned from top -->
            <StackPanel Grid.Row="2" Width="880" HorizontalAlignment="Center" VerticalAlignment="Top">

                <!-- ===== PAYMENT OPTION 1: Debit/Credit Card (selected by default) ===== -->
                <Border x:Name="CardPaymentBorder"
                        Background="#EEF2FF"
                        BorderBrush="#FF5C6BFF"
                        BorderThickness="2"
                        CornerRadius="24"
                        MinHeight="255"
                        Margin="0,0,0,30"
                        Padding="38,30"
                        Cursor="Hand"
                        MouseLeftButtonDown="CardPayment_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icon from Assets -->
                        <Image Source="/Assets/GPay_Card.png" 
                               Width="120" 
                               Height="120" 
                               Margin="0,0,32,0" 
                               Stretch="Uniform" 
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <!-- Text Details -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Debit/Credit Card" 
                                       FontFamily="Poppins" 
                                       FontWeight="SemiBold" 
                                       FontSize="28" 
                                       Foreground="#FF1C244B"/>
                            <TextBlock Text="OR" 
                                       FontFamily="Poppins" 
                                       FontSize="13" 
                                       Foreground="#FFA0A0AA" 
                                       Margin="0,4,0,4"/>
                            <TextBlock Text="Google Pay or Apple Pay" 
                                       FontFamily="Poppins" 
                                       FontSize="16" 
                                       Foreground="#FF6B7280"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== PAYMENT OPTION 2: Twint ===== -->
                <Border x:Name="TwintBorder"
                        Background="#FFFFFF"
                        BorderBrush="#FFE5E7EB"
                        BorderThickness="1.5"
                        CornerRadius="24"
                        MinHeight="255"
                        Margin="0,0,0,30"
                        Padding="38,30"
                        Cursor="Hand"
                        MouseLeftButtonDown="Twint_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icon from Assets -->
                        <Image Source="/Assets/Twint.png" 
                               Width="120" 
                               Height="120" 
                               Margin="0,0,32,0" 
                               Stretch="Uniform" 
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Twint" 
                                   FontFamily="Poppins" 
                                   FontWeight="SemiBold" 
                                   FontSize="28" 
                                   Foreground="#FF1C244B" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ===== PAYMENT OPTION 3: Pay with Coupon ===== -->
                <Border x:Name="CouponBorder"
                        Background="#FFFFFF"
                        BorderBrush="#FFE5E7EB"
                        BorderThickness="1.5"
                        CornerRadius="24"
                        MinHeight="255"
                        Margin="0,0,0,30"
                        Padding="38,30"
                        Cursor="Hand"
                        MouseLeftButtonDown="Coupon_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icon from Assets -->
                        <Image Source="/Assets/Coupon.png" 
                               Width="120" 
                               Height="120" 
                               Margin="0,0,32,0" 
                               Stretch="Uniform" 
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Pay with Coupon" 
                                   FontFamily="Poppins" 
                                   FontWeight="SemiBold" 
                                   FontSize="28" 
                                   Foreground="#FF1C244B" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ===== PAYMENT OPTION 4: Terminal (Card Reader) ===== -->
                <Border x:Name="TerminalBorder"
                        Background="#FFFFFF"
                        BorderBrush="#FFE5E7EB"
                        BorderThickness="1.5"
                        CornerRadius="24"
                        MinHeight="255"
                        Margin="0,0,0,0"
                        Padding="38,30"
                        Cursor="Hand"
                        MouseLeftButtonDown="Terminal_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icon from Assets -->
                        <Image Source="/Assets/Terminal.png" 
                               Width="120" 
                               Height="120" 
                               Margin="0,0,32,0" 
                               Stretch="Uniform" 
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Terminal (Card Reader)" 
                                   FontFamily="Poppins" 
                                   FontWeight="SemiBold" 
                                   FontSize="28" 
                                   Foreground="#FF1C244B" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

        </Grid>

        <!-- ===== 3. BOTTOM ACTION BUTTONS ===== -->
        <Grid Grid.Row="2" Width="880" Height="80" HorizontalAlignment="Center" Margin="0,0,0,60">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Back Button -->
            <Button Grid.Column="0"
                    x:Name="BackButton"
                    Click="BackButton_Click"
                    Background="#FFEFEFEF"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="16">
                            <TextBlock Text="BACK" 
                                       FontFamily="Poppins" 
                                       FontWeight="Bold" 
                                       FontSize="20" 
                                       Foreground="#FF4B5563" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Pay Now Action Button -->
            <Button Grid.Column="2"
                    x:Name="NextButton"
                    Click="NextButton_Click"
                    Background="#FF5C6BFF"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="16">
                            <TextBlock Text="PAY NOW" 
                                       FontFamily="Poppins" 
                                       FontWeight="Bold" 
                                       FontSize="20" 
                                       Foreground="White" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

    </Grid>
</Page>
