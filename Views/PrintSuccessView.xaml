<Page x:Class="kuboPix.Views.PrintSuccessView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="1920" d:DesignWidth="1080"
      Title="Print Success"
      Background="#FFFFFF"
      FontFamily="Poppins, Segoe UI"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      Loaded="Page_Loaded">

    <!-- Root Grid matching standard 3-row layout -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Logo Header -->
            <RowDefinition Height="*"/>    <!-- Row 1: Middle Success Viewport Content -->
            <RowDefinition Height="Auto"/> <!-- Row 2: Bottom Action Button -->
        </Grid.RowDefinitions>

        <!-- ===== 1. HEADER (Logo + Tagline) ===== -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Top"
                    Margin="0,95,0,0"
                    HorizontalAlignment="Center">
            <!-- Logo -->
            <Image Source="/Assets/logo.png"
                   Width="240"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Tagline -->
            <TextBlock Text="I N S T A N T   P H O T O   K I O S K" 
                       FontFamily="Poppins" 
                       FontWeight="Bold" 
                       FontSize="15" 
                       Foreground="#FF1C244B" 
                       HorizontalAlignment="Center" 
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- ===== 2. MIDDLE CONTENT (Vertically Centered 880px Viewport) ===== -->
        <Grid Grid.Row="1"
              Margin="0,40,0,40"
              HorizontalAlignment="Center"
              Width="880">

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <!-- Success Circle Graphic with playing PrintSuccess.mp4 Video -->
                <Border Width="300"
                        Height="300"
                        CornerRadius="150"
                        Background="#E6F9F0"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,36">
                    <Border Width="215"
                            Height="215"
                            CornerRadius="107.5"
                            Background="#10B981"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ClipToBounds="True">
                        <Grid>
                            <!-- MediaElement playing PrintSuccess.mp4 video -->
                            <MediaElement x:Name="SuccessVideo"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Stop"
                                          Stretch="UniformToFill"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          MediaEnded="SuccessVideo_MediaEnded"
                                          MediaFailed="SuccessVideo_MediaFailed"/>
                        </Grid>
                    </Border>
                </Border>

                <!-- Status Messages (Full 880px Width Centered Text) -->
                <StackPanel HorizontalAlignment="Stretch" Width="880">
                    <TextBlock Text="Print Successful!"
                               FontFamily="Poppins"
                               FontSize="38"
                               FontWeight="Bold"
                               Foreground="#FF1C244B"
                               TextAlignment="Center"
                               HorizontalAlignment="Stretch"
                               Width="880"
                               Margin="0,0,0,14"/>

                    <TextBlock Text="Please collect your Photo."
                               FontFamily="Poppins"
                               FontSize="22"
                               FontWeight="Medium"
                               Foreground="#FF4B5563"
                               TextAlignment="Center"
                               HorizontalAlignment="Stretch"
                               Width="880"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ===== 3. START AGAIN BUTTON (500px Width Button) ===== -->
        <Grid Grid.Row="2" Width="880" Height="80" HorizontalAlignment="Center" Margin="0,0,0,60">
            <Button x:Name="StartAgainButton"
                    Click="StartAgain_Click"
                    Background="#FF5C6BFF"
                    Width="500"
                    Height="80"
                    BorderThickness="0"
                    Cursor="Hand"
                    HorizontalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="16">
                            <TextBlock Text="START AGAIN" 
                                       FontFamily="Poppins" 
                                       FontWeight="Bold" 
                                       FontSize="22" 
                                       Foreground="White" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

    </Grid>
</Page>
