<Page x:Class="kuboPix.Views.PrintErrorView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="1920" d:DesignWidth="1080"
      Title="Print Error"
      Background="#FFFFFF"
      FontFamily="Poppins, Segoe UI"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      Loaded="Page_Loaded">

    <Page.Resources>
        <FontFamily x:Key="PoppinsFamily">
            pack://application:,,,/Fonts/Poppins/#Poppins
        </FontFamily>

        <!-- Retry Button Style -->
        <Style x:Key="KioskButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="72"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource PoppinsFamily}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Root Grid: content centered + Retry button pinned to bottom -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Logo/Header -->
            <RowDefinition Height="*"/>    <!-- Error card (Middle) -->
            <RowDefinition Height="Auto"/> <!-- Retry Button -->
        </Grid.RowDefinitions>

        <!-- ===== 1. HEADER (Logo + Tagline) ===== -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Top"
                    Margin="0,80,0,0"
                    HorizontalAlignment="Center">
            <!-- Logo -->
            <Image Source="/Assets/logo.png"
                   Width="180"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   MouseDown="Logo_Click_Error"/>

            <!-- Tagline -->
            <TextBlock Text="I N S T A N T   P H O T O   K I O S K" 
                       FontFamily="Poppins" 
                       FontWeight="Bold" 
                       FontSize="9" 
                       Foreground="#FF1C244B" 
                       HorizontalAlignment="Center" 
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- ===== 2. MIDDLE CONTENT (Error Illustration + Messages) ===== -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,20">
            
            <!-- Printer Error Illustration -->
            <Image Source="/Assets/PrintingError.png"
                   Width="220"
                   Height="220"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Status Messages -->
            <StackPanel HorizontalAlignment="Center"
                        Margin="0,40,0,0">

                <!-- Title -->
                <TextBlock x:Name="PrintingFailedTitle"
                           Text="Printing Error"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#1C244B"
                           FontFamily="{StaticResource PoppinsFamily}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <!-- Instruction -->
                <TextBlock x:Name="PrintingFailedInstruction"
                           Text="Unable to complete printing"
                           FontSize="18"
                           Foreground="#555555"
                           FontFamily="{StaticResource PoppinsFamily}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <!-- Payment Info (Stripe Case) — hidden by default -->
                <TextBlock x:Name="NoCharges"
                           Visibility="Collapsed"
                           Text="You will not be charged. The amount is only reserved temporarily on your card. Your card issuer will release it automatically within a few business days"
                           FontSize="14.5"
                           FontWeight="Medium"
                           Foreground="#555555"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="400"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <!-- Refund Timer (TWINT Case) — hidden by default -->
                <StackPanel x:Name="RefundTimerPanel"
                             Visibility="Collapsed"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,15">
                    <TextBlock Text="If the printer issue is not resolved within 10 minutes,"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="400"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="Red"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="your amount will be refunded automatically."
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="400"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="Red"
                               Margin="0,0,0,10"/>
                    <!-- Divider -->
                    <Border Height="1"
                            Background="#E0E0E0"
                            Width="300"
                            Margin="0,0,0,10"/>
                    <TextBlock x:Name="RefundTimerText"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="DarkGreen"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Error Message / Exception Text -->
                <TextBlock x:Name="ErrorMessageText"
                           Text=""
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#D32F2F"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="400"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>

            </StackPanel>
        </StackPanel>

        <!-- ===== 3. RETRY BUTTON — pinned to bottom ===== -->
        <Button Grid.Row="2"
                Style="{StaticResource KioskButtonStyle}"
                Background="#EEEEEE"
                Width="420"
                HorizontalAlignment="Center"
                Margin="0,0,0,60"
                Click="RetryButton_Click">
            <TextBlock Text="Retry"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#555555"
                       FontFamily="{StaticResource PoppinsFamily}"
                       VerticalAlignment="Center"/>
        </Button>

        <!-- ===== UNDER MAINTENANCE OVERLAY ===== -->
        <Grid x:Name="MaintenanceOverlay"
              Grid.Row="0"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              Background="#AA000000"
              Panel.ZIndex="999"
              MouseDown="Overlay_Click">
            <Border Background="White"
                    CornerRadius="24"
                    Padding="30"
                    Width="600"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="/Assets/MaintenancePopup.png"
                           Height="400"
                           Width="400"
                           Stretch="Uniform"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Page>
