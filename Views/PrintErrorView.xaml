<Page x:Class="MiniApp.Views.PrintErrorView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Print Error"
      Background="#FFFFFF"
      Loaded="Page_Loaded">

    <Grid>
        <!-- Background -->
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/bg.png"
                        Stretch="UniformToFill"/>
        </Grid.Background>

        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Logo -->
            <Image Grid.Row="0"
                   Source="/Assets/logo.png"
                   Height="55"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,30"
                   Stretch="Uniform"
                   MouseDown="Logo_Click_Error"/>

            <!-- Card -->
            <Border Grid.Row="1"
                    Background="#FFFFFF"
                    CornerRadius="24"
                    Padding="40"
                    Width="680"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="25"
                                      ShadowDepth="0"
                                      Opacity="0.2"/>
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Illustration -->
                    <Image Grid.Column="0"
                           Source="/Assets/PrintError.png"
                           Height="184"
                           Stretch="Uniform"
                           VerticalAlignment="Top" Margin="0,47,378,0" Grid.ColumnSpan="2"/>

                    <!-- Content -->
                    <StackPanel Grid.Column="1"
                                Margin="30,0,0,0"
                                VerticalAlignment="Center">

                        <!-- Title -->
                        <TextBlock x:Name="PrintingFailedTitle" Text="Printing failed"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="#000"
                                   Margin="0,0,0,10"/>

                        <!-- Instruction -->
                        <TextBlock x:Name="PrintingFailedInstruction" Text="Please ask for support at the nearest desk"
                                   FontSize="18"
                                   Foreground="#666"
                                   Margin="0,0,0,24"/>

                        <!-- Payment info -->
                        <TextBlock x:Name="NoCharges"  Visibility="Collapsed" Text="No charge has been made to your credit card"
                                   FontSize="16"
                                   FontWeight="Medium"
                                   Foreground="#000"/>
                        
                        <StackPanel x:Name="RefundTimerPanel"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            Margin="0,10,0,0">

                            <TextBlock Text="If the printer issue is not resolved within 10 minutes,"
               TextAlignment="Center"
               TextWrapping="Wrap"
               FontSize="15"
               FontWeight="Bold"
               Foreground="Red"
               Margin="0,0,0,5"/>
                            
                            <TextBlock Text="your amount will be refunded automatically."
               TextAlignment="Center"
               TextWrapping="Wrap"
               FontSize="15"
               FontWeight="Bold"
               Foreground="Red"
               Margin="0,0,0,5"/>
                            
                            <!-- Divider -->
                            <Border Height="1"
              Background="#E0E0E0"
              Margin="0,0,0,16"/>
                            
                            <TextBlock x:Name="RefundTimerText"
                   FontSize="22"
               FontWeight="Bold"
               Foreground="DarkGreen"
               HorizontalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="ErrorMessageText"
                        Text=""
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#D32F2F"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        MaxWidth="400"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0"/>

                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= UNDER MAINTENANCE OVERLAY ================= -->
        <Grid x:Name="MaintenanceOverlay"
              Visibility="Collapsed"
              Background="#AA000000"
              Panel.ZIndex="999"
              MouseDown="Overlay_Click"
              >

            <Border Background="White"
                    CornerRadius="24"
                    Padding="30"
                    Width="600"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel HorizontalAlignment="Center">

                    <Image Source="/Assets/MaintenancePopup.png"
                           Height="400"
                           Width="400"
                           Stretch="Uniform"/>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>


</Page>
