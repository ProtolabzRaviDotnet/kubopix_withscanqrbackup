<Page x:Class="kuboPix.Views.Edit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:kuboPix.Views"
      mc:Ignorable="d" 
      d:DesignHeight="1920" d:DesignWidth="1080"
      Background="#FFFFFF"
      FontFamily="Poppins, Segoe UI"
      Title="SelectFrame"
      >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Logo/Header -->
            <RowDefinition Height="*"/>    <!-- Stepper + Viewport/Selectors (Middle) -->
            <RowDefinition Height="Auto"/> <!-- Bottom Buttons -->
        </Grid.RowDefinitions>

        <!-- ===== 1. HEADER (Logo + Tagline) ===== -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Top"
                    Margin="0,80,0,0"
                    HorizontalAlignment="Center">
            <!-- Logo -->
            <Image Source="/Assets/logo.png" 
                   Width="180" 
                   Stretch="Uniform" 
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Tagline -->
            <TextBlock Text="I N S T A N T   P H O T O   K I O S K" 
                       FontFamily="Poppins" 
                       FontWeight="Bold" 
                       FontSize="9" 
                       Foreground="#FF1C244B" 
                       HorizontalAlignment="Center" 
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- ===== 2. MIDDLE CONTENT (Stepper + Viewport/Selectors) ===== -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,20"
                    Width="420">

            <!-- Stepper Progress Indicator -->
            <Grid Height="90" HorizontalAlignment="Center" Margin="0,0,0,100" Width="420">
                <!-- Connector Track Line behind circles -->
                <Grid Height="2" Margin="60,28,60,0" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#FF1C244B"/>
                    <Border Grid.Column="1" Background="#FFE5E7EB"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/> <!-- Step 1: Capture -->
                        <ColumnDefinition Width="*"/> <!-- Step 2: Edit -->
                        <ColumnDefinition Width="*"/> <!-- Step 3: Print -->
                    </Grid.ColumnDefinitions>

                    <!-- Step 1: Capture (Completed with Tick) -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <Grid Width="56" Height="56">
                            <Ellipse Fill="#FF1C244B" Width="56" Height="56"/>
                            <Path Data="M 20,28 L 26,34 L 38,22" Stroke="White" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </Grid>
                        <TextBlock Text="Capture" 
                                   FontFamily="Poppins" 
                                   FontWeight="SemiBold" 
                                   FontSize="14" 
                                   Foreground="#FF1C244B" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Step 2: Edit (Active) -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <Ellipse Stroke="#FF1C244B" StrokeThickness="2.5" Fill="White" Width="56" Height="56"/>
                        <TextBlock Text="Edit" 
                                   FontFamily="Poppins" 
                                   FontWeight="SemiBold" 
                                   FontSize="14" 
                                   Foreground="#FF1C244B" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Step 3: Print (Inactive) -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <Ellipse Stroke="#FFE5E7EB" StrokeThickness="2.5" Fill="White" Width="56" Height="56"/>
                        <TextBlock Text="Print" 
                                   FontFamily="Poppins" 
                                   FontSize="14" 
                                   Foreground="#FFA0A0AA" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Viewport & Selectors -->
            <StackPanel>
                <!-- 2. Image Viewport with Gridlines, Corner brackets, and Frame overlay -->
                <Border x:Name="PhotoBorder"
                        Width="320" 
                        Height="320" 
                        Background="#FFF9FAFB" 
                        BorderBrush="#FFE5E7EB" 
                        BorderThickness="1.5" 
                        CornerRadius="16"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20"
                        ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" 
                                          ShadowDepth="4" 
                                          Opacity="0.08" 
                                          Color="#000000"/>
                    </Border.Effect>

                    <Grid>
                        <!-- The captured photo display -->
                        <Image x:Name="CapturedPhoto" 
                               HorizontalAlignment="Stretch" 
                               VerticalAlignment="Stretch" 
                               Stretch="UniformToFill"/>

                        <!-- Grid Lines (3x3) -->
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="#60FFFFFF" BorderThickness="0,0,0,0.7" VerticalAlignment="Bottom"/>
                            <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#60FFFFFF" BorderThickness="0,0,0,0.7" VerticalAlignment="Bottom"/>
                            <Border Grid.Column="0" Grid.RowSpan="3" BorderBrush="#60FFFFFF" BorderThickness="0,0,0.7,0" HorizontalAlignment="Right"/>
                            <Border Grid.Column="1" Grid.RowSpan="3" BorderBrush="#60FFFFFF" BorderThickness="0,0,0.7,0" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Corner Brackets (for crop guides) -->
                        <Grid Margin="12" IsHitTestVisible="False">
                            <!-- Top-Left -->
                            <Path Data="M 0,16 L 0,0 L 16,0" Stroke="White" StrokeThickness="3.5" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <!-- Top-Right -->
                            <Path Data="M 0,0 L 16,0 L 16,16" Stroke="White" StrokeThickness="3.5" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            <!-- Bottom-Left -->
                            <Path Data="M 0,0 L 0,16 L 16,16" Stroke="White" StrokeThickness="3.5" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                            <!-- Bottom-Right -->
                            <Path Data="M 0,16 L 16,16 L 16,0" Stroke="White" StrokeThickness="3.5" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>

                        <!-- Frame Overlay -->
                        <Image x:Name="FrameOverlay" 
                               HorizontalAlignment="Stretch" 
                               VerticalAlignment="Stretch" 
                               Stretch="Fill"
                               Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- 3. Dynamic Frame & Background Selector Panel -->
                <Border Width="420" 
                        Background="White" 
                        BorderBrush="#FFF3F4F6" 
                        BorderThickness="1" 
                        CornerRadius="24"
                        HorizontalAlignment="Center"
                        Padding="25,15,25,15"
                        Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" 
                                          ShadowDepth="4" 
                                          Opacity="0.06" 
                                          Color="#000000"/>
                    </Border.Effect>
                    
                    <StackPanel>
                        <!-- Frame Section -->
                        <TextBlock Text="Select a Frame" 
                                   FontFamily="Poppins" 
                                   FontWeight="SemiBold" 
                                   FontSize="15" 
                                   Foreground="#FF5C6BFF" 
                                   Margin="0,0,0,10"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15" HorizontalAlignment="Center">
                            <!-- Frame Item: None -->
                            <StackPanel Margin="0,0,20,0" HorizontalAlignment="Center">
                                <Border x:Name="FrameNoneBorder" 
                                        BorderBrush="#FF5C6BFF" 
                                        BorderThickness="2.5" 
                                        CornerRadius="8" 
                                        Width="76" 
                                        Height="76" 
                                        Background="White" 
                                        Cursor="Hand" 
                                        MouseLeftButtonDown="FrameNone_Click">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Stroke="#FFA0A0AA" StrokeThickness="1.5" Width="30" Height="30"/>
                                        <Path Data="M 12,28 L 28,12" Stroke="#FFA0A0AA" StrokeThickness="1.5"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="none" FontFamily="Poppins" FontSize="11" Foreground="#FFA0A0AA" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Frame Item: Ellipse -->
                            <StackPanel Margin="0,0,20,0" HorizontalAlignment="Center">
                                <Border x:Name="FrameEllipseBorder" 
                                        BorderBrush="#FFE5E7EB" 
                                        BorderThickness="1.5" 
                                        CornerRadius="8" 
                                        Width="76" 
                                        Height="76" 
                                        Background="White" 
                                        Cursor="Hand" 
                                        MouseLeftButtonDown="FrameEllipse_Click">
                                    <Image Source="/Assets/Ellipse 5@2x.png" Stretch="Uniform" Margin="8"/>
                                </Border>
                                <TextBlock Text="Ellipse" FontFamily="Poppins" FontSize="11" Foreground="#FFA0A0AA" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Frame Item: Bottle -->
                            <StackPanel Margin="0,0,20,0" HorizontalAlignment="Center">
                                <Border x:Name="FrameBottleBorder" 
                                        BorderBrush="#FFE5E7EB" 
                                        BorderThickness="1.5" 
                                        CornerRadius="8" 
                                        Width="76" 
                                        Height="76" 
                                        Background="White" 
                                        Cursor="Hand" 
                                        MouseLeftButtonDown="FrameBottle_Click">
                                    <Image Source="/Assets/750mL Bottles (3)@2x.png" Stretch="Uniform" Margin="8"/>
                                </Border>
                                <TextBlock Text="Bottle" FontFamily="Poppins" FontSize="11" Foreground="#FFA0A0AA" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Background Section -->
                        <TextBlock Text="Select a Background" 
                                   FontFamily="Poppins" 
                                   FontWeight="SemiBold" 
                                   FontSize="15" 
                                   Foreground="#FF1C244B" 
                                   Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- Background Item: None -->
                            <StackPanel Margin="0,0,15,0" HorizontalAlignment="Center">
                                <Border x:Name="BgNoneBorder" 
                                        BorderBrush="#FF5C6BFF" 
                                        BorderThickness="2.5" 
                                        CornerRadius="8" 
                                        Width="76" 
                                        Height="76" 
                                        Background="White" 
                                        Cursor="Hand" 
                                        MouseLeftButtonDown="BgNone_Click">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Stroke="#FFA0A0AA" StrokeThickness="1.5" Width="30" Height="30"/>
                                        <Path Data="M 12,28 L 28,12" Stroke="#FFA0A0AA" StrokeThickness="1.5"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="none" FontFamily="Poppins" FontSize="11" Foreground="#FFA0A0AA" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Background Item: Winter -->
                            <StackPanel Margin="0,0,15,0" HorizontalAlignment="Center">
                                <Border x:Name="BgWinterBorder" 
                                        BorderBrush="#FFE5E7EB" 
                                        BorderThickness="1.5" 
                                        CornerRadius="8" 
                                        Width="76" 
                                        Height="76" 
                                        Background="White" 
                                        Cursor="Hand" 
                                        MouseLeftButtonDown="BgWinter_Click">
                                    <Border Background="#FFE0F2FE" CornerRadius="4" Margin="8"/>
                                </Border>
                                <TextBlock Text="Winter" FontFamily="Poppins" FontSize="11" Foreground="#FFA0A0AA" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Background Item: Xmas -->
                            <StackPanel Margin="0,0,15,0" HorizontalAlignment="Center">
                                <Border x:Name="BgXmasBorder" 
                                        BorderBrush="#FFE5E7EB" 
                                        BorderThickness="1.5" 
                                        CornerRadius="8" 
                                        Width="76" 
                                        Height="76" 
                                        Background="White" 
                                        Cursor="Hand" 
                                        MouseLeftButtonDown="BgXmas_Click">
                                    <Border Background="#FEE2E2" CornerRadius="4" Margin="8"/>
                                </Border>
                                <TextBlock Text="X-Mas" FontFamily="Poppins" FontSize="11" Foreground="#FFA0A0AA" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Background Item: Summer -->
                            <StackPanel Margin="0,0,15,0" HorizontalAlignment="Center">
                                <Border x:Name="BgSummerBorder" 
                                        BorderBrush="#FFE5E7EB" 
                                        BorderThickness="1.5" 
                                        CornerRadius="8" 
                                        Width="76" 
                                        Height="76" 
                                        Background="White" 
                                        Cursor="Hand" 
                                        MouseLeftButtonDown="BgSummer_Click">
                                    <Border Background="#FEF3C7" CornerRadius="4" Margin="8"/>
                                </Border>
                                <TextBlock Text="Summer" FontFamily="Poppins" FontSize="11" Foreground="#FFA0A0AA" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>

        <!-- ===== 3. BOTTOM ACTION BUTTONS ===== -->
        <Grid Grid.Row="2" Width="420" Height="65" HorizontalAlignment="Center" Margin="0,0,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Back Button -->
            <Button Grid.Column="0"
                    x:Name="BackButton"
                    Click="BackButton_Click"
                    Background="#FFEFEFEF"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="10">
                            <TextBlock Text="BACK" 
                                       FontFamily="Poppins" 
                                       FontWeight="Bold" 
                                       FontSize="18" 
                                       Foreground="#FF4B5563" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Next Action Button -->
            <Button Grid.Column="2"
                    x:Name="ContinueButton"
                    Click="ContinueButton_Click"
                    Background="#FF5C6BFF"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="10">
                            <TextBlock Text="NEXT" 
                                       FontFamily="Poppins" 
                                       FontWeight="Bold" 
                                       FontSize="18" 
                                       Foreground="White" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

    </Grid>
</Page>
