<Page x:Class="kuboPix.Views.PrintProgressView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="Print Progress"
      Loaded="Page_Loaded"
      Background="#FFFFFF"
      FontFamily="Poppins, Segoe UI"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Logo/Header -->
            <RowDefinition Height="*"/>    <!-- Main Card Content -->
        </Grid.RowDefinitions>

        <!-- Keep the LoaderVideo and TimerText hidden to satisfy code-behind logic without affecting UI -->
        <Grid Grid.Row="0" Visibility="Collapsed">
            <MediaElement x:Name="LoaderVideo"
                           LoadedBehavior="Manual"
                           UnloadedBehavior="Stop"
                           MediaEnded="LoaderVideo_MediaEnded"
                           MediaFailed="LoaderVideo_MediaFailed"/>
            <TextBlock x:Name="TimerText" Text="00:30"/>
        </Grid>

        <!-- ================= HEADER (Logo + Tagline) ================= -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Top"
                    Margin="0,80,0,0"
                    HorizontalAlignment="Center">
            <Image Source="/Assets/logo.png"
                   Width="270"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <TextBlock Margin="0,15,0,0"
                       Text="INSTANT PHOTO KIOSK"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#1C244B"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- ================= Progress Content (No Card Border) ================= -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,20">

            <!-- Illustration -->
            <Image Source="/Assets/PrintingProgress.png"
                   Width="200"
                   Height="200"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Margin="0,0,0,40"/>

            <!-- Status Text -->
            <TextBlock Text="Printing in progress..."
                       FontSize="20"
                       FontWeight="Medium"
                       Foreground="#4C6FFF"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

            <!-- Progress Bar -->
            <ProgressBar x:Name="progressBar"
                         Height="8"
                         Width="320"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Background="#F0F2F5"
                         Foreground="#4C6FFF"
                         BorderThickness="0"
                         HorizontalAlignment="Center">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Grid x:Name="TemplateRoot">
                                        <!-- Background track -->
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4" />
                                        <!-- Track container that ProgressBar uses to measure width -->
                                        <Grid x:Name="PART_Track">
                                            <Border x:Name="PART_Indicator"
                                                    Background="{TemplateBinding Foreground}"
                                                    CornerRadius="4"
                                                    HorizontalAlignment="Left" />
                                        </Grid>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
        </StackPanel>
    </Grid>
</Page>
