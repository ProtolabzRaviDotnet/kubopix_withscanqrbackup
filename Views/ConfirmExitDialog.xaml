<Window x:Class="kuboPix.Views.ConfirmExitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Height="260" Width="430">

    <!-- Viewbox + fixed canvas: the dialog is resized to match the UI scale (DialogScaler),
         and this scales the contents to fit. Canvas size = the design size on the Window. -->
    <Viewbox Stretch="Uniform">
      <Grid Width="430" Height="260">
    <Border CornerRadius="18" Background="White" Padding="20">
        <StackPanel VerticalAlignment="Center">

            <!-- Icon Circle + Logout Icon -->
            <Grid Width="70" Height="70" HorizontalAlignment="Center">

                <!-- Circle -->
                <Ellipse Fill="#F3F3F3">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#000"
                               BlurRadius="15"
                               ShadowDepth="0"
                               Opacity="0.25"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- Icon inside circle -->
                <Image Source="/Assets/logout.png"
            Width="28" Height="28"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"/>
            </Grid>


            <!-- Title -->
            <TextBlock Text="Exit KuboPix ?"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#333"
                       Margin="0,15,0,5"
                       HorizontalAlignment="Center"/>

            <!-- Subtitle -->
            <TextBlock Text="Are you sure you want to exit KuboPix?"
                       FontSize="14"
                       Foreground="#777"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Width="120" Height="40"
                        Margin="0,0,10,0"
                        Background="#EEE"
                        BorderBrush="#DDD"
                        BorderThickness="1"
                        Foreground="#444"
                        Click="Cancel_Click"
                        TouchDown="OnButtonTouchDown"
                        Focusable="True"
                        />

                <Button x:Name="ExitButton"
                        Content="Exit"
                        Width="120" Height="40"
                        Background="#E53935"
                        Foreground="White"
                        BorderThickness="0"
                        TouchDown="OnButtonTouchDown"
                        Focusable="True"
                        Click="Exit_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
      </Grid>
    </Viewbox>
</Window>
