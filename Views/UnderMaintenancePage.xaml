<Page x:Class="kuboPix.Views.UnderMaintenancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="1920" d:DesignWidth="1080"
      Title="Kiosk Under Maintenance"
      Background="#FFFFFF"
      FontFamily="Poppins, Segoe UI"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Logo/Header -->
            <RowDefinition Height="*"/>    <!-- Main Content (Card) -->
        </Grid.RowDefinitions>

        <!-- ================= HEADER (Logo + Tagline) ================= -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Top"
                    Margin="0,120,0,0"
                    HorizontalAlignment="Center">
            <Image Source="/Assets/logo.png"
                   Width="240"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   MouseDown="Logo_Click_UM"/>
            <TextBlock Text="I N S T A N T   P H O T O   K I O S K" 
                       FontFamily="Poppins" 
                       FontWeight="Bold" 
                       FontSize="15" 
                       Foreground="#FF1C244B" 
                       HorizontalAlignment="Center" 
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- ================= CARD (Middle Content) ================= -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,20">
            <Border Width="480"
                    Background="White"
                    BorderBrush="#E8ECEF"
                    BorderThickness="1.5"
                    CornerRadius="36"
                    HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30"
                                      ShadowDepth="8"
                                      Color="#000000"
                                      Opacity="0.08"/>
                </Border.Effect>

                <Grid Margin="40,60,40,60">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Illustration -->
                        <RowDefinition Height="35"/>   <!-- Spacer -->
                        <RowDefinition Height="Auto"/> <!-- Messages -->
                    </Grid.RowDefinitions>

                    <!-- Illustration: Under Maintenance -->
                    <Grid Grid.Row="0"
                          Width="200"
                          Height="200"
                          HorizontalAlignment="Center">
                        <!-- Grey Circle Background -->
                        <Ellipse Fill="#F2F4F7"/>
                        <!-- Maintenance Image -->
                        <Image Source="/Assets/UnderMaintenance.png"
                               Width="120"
                               Height="120"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>

                    <!-- Content (Title, Instruction/Message) -->
                    <StackPanel Grid.Row="2"
                                Orientation="Vertical"
                                HorizontalAlignment="Center">

                        <!-- Title -->
                        <TextBlock Text="Kiosk Under Maintenance"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#1C244B"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"
                                   TextAlignment="Center"/>

                        <!-- Message -->
                        <TextBlock x:Name="ErrorMessageText"
                                   Text="This kiosk is currently under maintenance. Services are temporarily unavailable. Please try again after some time."
                                   FontSize="15"
                                   Foreground="#555555"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="360"
                                   HorizontalAlignment="Center"
                                   LineHeight="22"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Page>
