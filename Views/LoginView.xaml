<Page x:Class="kuboPix.Views.LoginView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:kuboPix.Views"
      mc:Ignorable="d"
      Background="#FFFFFF"
      FontFamily="Poppins, Segoe UI"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="Auto"
      Title="Login">

    <Page.Resources>
        <!-- Custom style for the email input box -->
        <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFF9FAFB"/>
            <Setter Property="BorderBrush" Value="#FFE5E7EB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#FF1C244B"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontFamily" Value="Poppins, Segoe UI"/>
            <Setter Property="Height" Value="82"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="18"
                                    SnapsToDevicePixels="True"/>
                            <ScrollViewer x:Name="PART_ContentHost" 
                                           Focusable="false" 
                                           HorizontalScrollBarVisibility="Hidden" 
                                           VerticalScrollBarVisibility="Hidden" 
                                           Margin="{TemplateBinding Padding}"/>
                            <TextBlock x:Name="placeholder"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="#FFA0A0AA"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       VerticalAlignment="Center"
                                       Margin="26,0,26,0"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF5C6BFF"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                <Setter Property="Background" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom style for the password input box -->
        <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#FFF9FAFB"/>
            <Setter Property="BorderBrush" Value="#FFE5E7EB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#FF1C244B"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontFamily" Value="Poppins, Segoe UI"/>
            <Setter Property="Height" Value="82"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                           Focusable="false" 
                                           HorizontalScrollBarVisibility="Hidden" 
                                           VerticalScrollBarVisibility="Hidden" 
                                           Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF5C6BFF"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                <Setter Property="Background" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Login Button Style with hover/press transitions -->
        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="96"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- Root Grid with standard 3-row layout -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Logo Header -->
            <RowDefinition Height="*"/>    <!-- Row 1: 920px Viewport Card -->
        </Grid.RowDefinitions>

        <!-- ===== Exit KuboPix Button (Top-Right) ===== -->
        <Button x:Name="AdminExitButton"
                Grid.Row="0"
                Width="95" Height="95"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,35,40,0"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                ToolTip="Exit KuboPix"
                Click="AdminExitButton_Click_Login"
                TouchDown="AdminExitButton_TouchDown"
                Focusable="True">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ButtonContent" Background="Transparent">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonContent" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ButtonContent" Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Icon + Circle (Drop Shadow) -->
                <Grid Width="55" Height="55">
                    <Ellipse Fill="#F3F3F3">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#000000"
                                              BlurRadius="15"
                                              ShadowDepth="0"
                                              Opacity="0.25"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <Image Source="/Assets/logout.png"
                           Width="28" Height="28"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                </Grid>

                <TextBlock Text="Exit KuboPix"
                           Margin="0,6,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#444444"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- ===== 1. HEADER (Standard Kiosk Header) ===== -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Top"
                    Margin="0,45,0,0"
                    HorizontalAlignment="Center">
            <!-- Logo -->
            <Image Source="/Assets/logo.png"
                   Width="240"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Tagline -->
            <TextBlock Text="I N S T A N T   P H O T O   K I O S K" 
                       FontFamily="Poppins" 
                       FontWeight="Bold" 
                       FontSize="16" 
                       Foreground="#FF1C244B" 
                       HorizontalAlignment="Center" 
                       Margin="0,10,0,0"/>
        </StackPanel>

        <!-- ===== 2. MIDDLE CONTENT (920px Viewport Login Card) ===== -->
        <Grid Grid.Row="1"
              Margin="0,15,0,25"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="920">

            <!-- Background Shadow Border (Empty: renders shadow without rasterizing text) -->
            <Border CornerRadius="32"
                    Background="White"
                    Width="820"
                    MinHeight="1080"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{Binding Visibility, ElementName=LoginCard}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="35" 
                                      ShadowDepth="10" 
                                      Opacity="0.07" 
                                      Color="#000000"/>
                </Border.Effect>
            </Border>

            <!-- Card Content (No Effect: retains sharp vector text and ClearType) -->
            <Border x:Name="LoginCard"
                    Background="White"
                    BorderBrush="#E8ECEF"
                    BorderThickness="1.5"
                    CornerRadius="32"
                    Width="820"
                    MinHeight="1080"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                <StackPanel Margin="60,85,60,85" VerticalAlignment="Center">
                    <!-- Card Header -->
                    <TextBlock Text="Please log in to your account to continue" 
                               FontFamily="Poppins" 
                               FontWeight="SemiBold"
                               FontSize="28" 
                               Foreground="#FF1C244B" 
                               Margin="0,0,0,44"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>

                    <!-- Email Input Field -->
                    <TextBlock Text="EMAIL ADDRESS" 
                               FontFamily="Poppins" 
                               FontWeight="Bold" 
                               FontSize="17" 
                               Foreground="#FF1C244B" 
                               Margin="0,0,0,12"/>
                    <TextBox x:Name="txtEmail"
                             Style="{StaticResource LoginTextBoxStyle}"
                             Tag="Enter your email address"
                             Margin="0,0,0,32"
                             PreviewTouchDown="OnTextInputTouchDown"  
                             GotFocus="OnTextInputGotFocus"
                             LostFocus="OnTextInputLostFocus"/>

                    <!-- Password Input Field -->
                    <TextBlock Text="PASSWORD" 
                               FontFamily="Poppins" 
                               FontWeight="Bold" 
                               FontSize="17" 
                               Foreground="#FF1C244B" 
                               Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,32">
                        <PasswordBox x:Name="txtPassword"
                                     Style="{StaticResource LoginPasswordBoxStyle}"
                                     PasswordChanged="txtPassword_PasswordChanged"
                                     PreviewTouchDown="OnTextInputTouchDown"  
                                     GotFocus="OnTextInputGotFocus"
                                     LostFocus="OnTextInputLostFocus"/>
                        <TextBlock x:Name="txtPasswordPlaceholder"
                                   Text="Enter your password"
                                   Foreground="#FFA0A0AA"
                                   FontSize="22"
                                   FontFamily="Poppins, Segoe UI"
                                   VerticalAlignment="Center"
                                   Margin="26,0,0,0"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Error Message Block -->
                    <TextBlock x:Name="txtErrorMessage" 
                               Foreground="#FFEF4444" 
                               FontSize="20" 
                               FontFamily="Poppins"
                               TextAlignment="Center" 
                               Margin="0,0,0,14" 
                               Visibility="Collapsed" 
                               TextWrapping="Wrap"/>

                    <!-- Printer Status Text Block -->
                    <TextBlock x:Name="txtPrinterStatus" 
                               Foreground="#FF1C244B" 
                               FontSize="22" 
                               FontWeight="SemiBold"
                               FontFamily="Poppins"
                               TextAlignment="Center" 
                               Margin="0,0,0,28" 
                               TextWrapping="Wrap"/>

                    <!-- Login Action Button -->
                    <Button x:Name="btnLogin"
                            Style="{StaticResource LoginButtonStyle}"
                            Background="#FF5C6BFF"
                            Click="Login_Click"
                            TouchDown="Login_TouchDown"
                            KeyDown="Login_KeyDown">
                        <TextBlock x:Name="LoginButtonText"
                                   Text="LOG IN"
                                   FontFamily="Poppins"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Loading Overlay: spans across all rows to cover the entire UI -->
        <Grid x:Name="LoadingOverlay"
              Grid.Row="0"
              Grid.RowSpan="2"
              Background="#80000000"
              Visibility="Collapsed"
              Panel.ZIndex="999">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ProgressBar Width="240"
                             Height="10"
                             IsIndeterminate="True"/>
                <TextBlock Text="Please wait..."
                           Margin="0,20,0,0"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
