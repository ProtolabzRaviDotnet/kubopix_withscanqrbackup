<Page x:Class="MiniApp.Views.LoginView" x:Name="LoginCard"
Visibility="Collapsed"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="MiniPC Login"
      Background="#FFFFFF">

    <!-- RESOURCES -->
    <Page.Resources>
        <FontFamily x:Key="PoppinsFamilyLocal">pack://application:,,,/Fonts/Poppins/#Poppins</FontFamily>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource PoppinsFamilyLocal}" />
        </Style>

        <Style TargetType="Control">
            <Setter Property="FontFamily" Value="{StaticResource PoppinsFamilyLocal}" />
        </Style>

        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E6E6E6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Focusable" Value="True" />
            <!-- Add for touch focus -->
            <Setter Property="IsTabStop" Value="True" />
            <!-- Keyboard navigation -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedPassword" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E6E6E6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Focusable" Value="True" />
            <!-- Add for touch focus -->
            <Setter Property="IsTabStop" Value="True" />
            <!-- Keyboard navigation -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#5B6BFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <!-- Add for touch -->
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="IsManipulationEnabled" Value="False" />
            <!-- Prevent touch gestures -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Height="{TemplateBinding Height}"
                                Width="{TemplateBinding Width}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>

                            <!-- Touch-safe hover (Fix for touchscreen “auto-close” issue) -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsPressed" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#4657E6"/>
                            </MultiTrigger>

                            <!-- Pressed state (works for touch + mouse) -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>

                            <!-- Disabled -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>


    <!-- MAIN LAYOUT -->
    <Grid>
        <!-- Background -->
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/bg.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Login Card -->
        <Border Width="940" Height="500" CornerRadius="24" Padding="28"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#EFEFEF">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.18"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Image Grid.Row="0" Source="/Assets/logo.png"
                       Height="86" HorizontalAlignment="Center" Margin="0,6,0,18"
                       Stretch="Uniform"/>

                <!-- Form Section -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="430"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left image -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Image Source="/Assets/groupimage.png"
                               Width="360" Height="260"
                               Stretch="UniformToFill" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Right form -->
                    <StackPanel Grid.Column="1" Margin="40,6,20,6" VerticalAlignment="Center">
                        <TextBlock Text="Log in to"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="#0F172A" Margin="0,0,0,6"/>
                        <TextBlock Text="Printer Management Interface"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="#5671ff" Margin="0,0,0,6"/>

                        <!-- Email -->
                        <TextBlock Text="Email" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#444" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <TextBox x:Name="txtEmail"
                                     Style="{StaticResource RoundedTextBox}"
                                     Foreground="Black"
                                     TextChanged="txtEmail_TextChanged"
                                     PreviewTouchDown="OnTextInputTouchDown"  
                                     GotFocus="OnTextInputGotFocus"
                                     LostFocus="OnTextInputLostFocus"/>

                            <TextBlock x:Name="txtEmailPlaceholder"
                                       Text="Enter your Email"
                                       Foreground="Gray"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>

                        <!-- Password -->
                        <TextBlock Text="Password" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#444" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,20">
                            <PasswordBox x:Name="txtPassword"
                                         Style="{StaticResource RoundedPassword}"
                                         PasswordChanged="txtPassword_PasswordChanged"
                                         PreviewTouchDown="OnTextInputTouchDown"  
                                         GotFocus="OnTextInputGotFocus"
                                         LostFocus="OnTextInputLostFocus"/>

                            <TextBlock x:Name="txtPasswordPlaceholder"
                                       Text="Enter your Password"
                                       Foreground="Gray"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>

                        <!-- Printer Status -->
                        <TextBlock x:Name="txtPrinterStatus"
                                   Text="🔄 Fetching printer details..."
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#444" Margin="0,0,0,12"/>

                        <!-- Login Button -->
                        <Button x:Name="btnLogin"
                                Content="Login"
                                Height="44"
                                Width="392"
                                HorizontalAlignment="Left"
                                Style="{StaticResource PrimaryButton}"
                                IsEnabled="False"
                                Click="Login_Click"
                                TouchDown="Login_TouchDown" 
                                KeyDown="Login_KeyDown"/>

                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Overlay -->
        <Grid x:Name="LoadingOverlay" Background="#80000000" Visibility="Collapsed"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Panel.ZIndex="99">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="White" CornerRadius="12" Padding="24">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="180" Height="8" Margin="0,0,0,12"/>
                        <TextBlock Text="Please wait..." Foreground="#333" FontWeight="SemiBold"
                                   FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        
        <!-- Exit Button -->
        <Button x:Name="AdminExitButton"
    Width="80" Height="90"
    HorizontalAlignment="Right"
    VerticalAlignment="Top"
    Margin="0,20,20,0"
    Background="Transparent"
    BorderThickness="0"
    Cursor="Hand"
    ToolTip="Exit Mini App"
    Click="AdminExitButton_Click_Login"
    TouchDown="AdminExitButton_TouchDown"
   Focusable="True">

            <!-- Remove dotted outline on click -->
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Icon + Circle (No Hover Animation Now) -->
                <Grid Width="55" Height="55">
                    <Ellipse Fill="#F3F3F3">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#000"
                                  BlurRadius="15"
                                  ShadowDepth="0"
                                  Opacity="0.25"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <Image Source="/Assets/logout.png"
               Width="28" Height="28"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"/>
                </Grid>

                <TextBlock Text="Exit MiniApp"
               Margin="0,6,0,0"
               FontSize="13"
               FontWeight="SemiBold"
               Foreground="#444"
               HorizontalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</Page>

