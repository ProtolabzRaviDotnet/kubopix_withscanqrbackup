<Page x:Class="kuboPix.Views.LoginView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:kuboPix.Views"
      mc:Ignorable="d"
      Background="#FFFFFF"
      FontFamily="Poppins, Segoe UI"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      Title="Login"
     >

    <Page.Resources>
        <!-- Custom style for the email input box with watermark/placeholder -->
        <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFF9FAFB"/>
            <Setter Property="BorderBrush" Value="#FFE5E7EB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#FF1C244B"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Poppins, Segoe UI"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"
                                    SnapsToDevicePixels="True"/>
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Focusable="false" 
                                          HorizontalScrollBarVisibility="Hidden" 
                                          VerticalScrollBarVisibility="Hidden" 
                                          Margin="{TemplateBinding Padding}"/>
                            <TextBlock x:Name="placeholder"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="#FFA0A0AA"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       VerticalAlignment="Center"
                                       Margin="18,0,18,0"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF5671FF"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                <Setter Property="Background" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom style for the password input box -->
        <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#FFF9FAFB"/>
            <Setter Property="BorderBrush" Value="#FFE5E7EB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#FF1C244B"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Poppins, Segoe UI"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Focusable="false" 
                                          HorizontalScrollBarVisibility="Hidden" 
                                          VerticalScrollBarVisibility="Hidden" 
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF5671FF"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                <Setter Property="Background" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Login Button Style with hover/press transitions -->
        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="80"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>

        <!-- Centered Group (Header + Card) -->
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <!-- ================= HEADER ================= -->
            <StackPanel Margin="0,0,0,80"
                        HorizontalAlignment="Center">
                <Image Source="/Assets/logo.png" 
                       Width="270" 
                       Stretch="Uniform" 
                       HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="INSTANT PHOTO KIOSK" 
                           FontFamily="Poppins" 
                           FontWeight="SemiBold" 
                           FontSize="22" 
                           Foreground="#FF1C244B" 
                           HorizontalAlignment="Center" 
                           Margin="0,15,0,0"/>
            </StackPanel>
 
            <!-- ================= CARD ================= -->
            <Border x:Name="LoginCard"
                    Background="White"
                    BorderBrush="#E8ECEF"
                    BorderThickness="1.5"
                    CornerRadius="36"
                    Width="500"
                    MaxHeight="1200"
                    HorizontalAlignment="Center">
                
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" 
                                      ShadowDepth="8" 
                                      Opacity="0.08" 
                                      Color="#000000"/>
                </Border.Effect>
 
                <StackPanel Margin="45,80,45,80" VerticalAlignment="Center">
                    <!-- Card Header -->
                    <TextBlock Text="Please log in to your account to continue" 
                               FontFamily="Poppins" 
                               FontWeight="Medium"
                               FontSize="18" 
                               Foreground="#FF1C244B" 
                               Margin="0,0,0,40"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>

                    <!-- Email Input Field -->
                    <TextBlock Text="EMAIL ADDRESS" 
                               FontFamily="Poppins" 
                               FontWeight="Bold" 
                               FontSize="12" 
                               Foreground="#FF1C244B" 
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="txtEmail"
                             Style="{StaticResource LoginTextBoxStyle}"
                             Tag="Enter your email address"
                             Margin="0,0,0,24"/>

                    <!-- Password Input Field -->
                    <TextBlock Text="PASSWORD" 
                               FontFamily="Poppins" 
                               FontWeight="Bold" 
                               FontSize="12" 
                               Foreground="#FF1C244B" 
                               Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,24">
                        <PasswordBox x:Name="txtPassword"
                                     Style="{StaticResource LoginPasswordBoxStyle}"
                                     PasswordChanged="txtPassword_PasswordChanged"/>
                        <TextBlock x:Name="txtPasswordPlaceholder"
                                   Text="Enter your password"
                                   Foreground="#FFA0A0AA"
                                   FontSize="16"
                                   FontFamily="Poppins, Segoe UI"
                                   VerticalAlignment="Center"
                                   Margin="18,0,0,0"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Error Message Block -->
                    <TextBlock x:Name="txtErrorMessage" 
                               Foreground="#FFEF4444" 
                               FontSize="14" 
                               FontFamily="Poppins"
                               TextAlignment="Center" 
                               Margin="0,0,0,12" 
                               Visibility="Collapsed" 
                               TextWrapping="Wrap"/>

                    <!-- Printer Status Text Block -->
                    <TextBlock x:Name="txtPrinterStatus" 
                               Foreground="#FF1C244B" 
                               FontSize="14" 
                               FontFamily="Poppins"
                               TextAlignment="Center" 
                               Margin="0,0,0,24" 
                               TextWrapping="Wrap"/>

                    <!-- Login Action Button -->
                    <Button x:Name="btnLogin"
                            Style="{StaticResource LoginButtonStyle}"
                            Background="#FF5671FF"
                            Click="Login_Click"
                            TouchDown="Login_TouchDown"
                            KeyDown="Login_KeyDown">
                        <TextBlock x:Name="LoginButtonText"
                                   Text="LOG IN"
                                   FontFamily="Poppins"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay"
              Background="#80000000"
              Visibility="Collapsed"
              Panel.ZIndex="999">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ProgressBar Width="220"
                             Height="8"
                             IsIndeterminate="True"/>
                <TextBlock Text="Please wait..."
                           Margin="0,20,0,0"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
