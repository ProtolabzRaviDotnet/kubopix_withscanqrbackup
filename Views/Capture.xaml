<Page x:Class="kuboPix.Views.Capture"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="1920" d:DesignWidth="1080"
      Title="Capture"
      Background="White"
      FontFamily="Poppins,Segoe UI"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType">

    <Page.Resources>

        <!-- Card Button Style -->
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="32"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20"
                                                  ShadowDepth="4"
                                                  Opacity="0.04"
                                                  Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#EAECEF"/>
                                <Setter TargetName="CardBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="25" ShadowDepth="6" Opacity="0.09" Color="#000000"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#E0E3E8"/>
                                <Setter TargetName="CardBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Color="#000000"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Terms and Conditions Popup Cancel Button Style -->
        <Style x:Key="PopupCancelButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="White"
                                BorderBrush="#3E63FF"
                                BorderThickness="2"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F0F4FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E2E9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Terms and Conditions Popup Accept Button Style -->
        <Style x:Key="PopupAcceptButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="#3E63FF"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Header (Logo) -->
            <RowDefinition Height="*"/>    <!-- Row 1: Main Content -->
        </Grid.RowDefinitions>

        <!-- Dynamic Start Screen Background (ContentTypeId 1 from KuboPixContentService) -->
        <Image x:Name="imgStartBackground"
               Grid.RowSpan="2"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False"/>

        <!-- ================= Version Pill Badge (Top-Right) ================= -->
        <Border Grid.Row="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,32,40,0"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="1.5"
                CornerRadius="22"
                Padding="20,10,22,10"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16"
                                  ShadowDepth="3"
                                  Opacity="0.08"
                                  Color="#1C244B"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Theme Accent Indicator Dot (Kubopix Orange) -->
                <Border Width="12"
                        Height="12"
                        CornerRadius="6"
                        Background="#F58220"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"/>
                <TextBlock x:Name="txtAppVersion"
                           Text="Kubopix_1.0.0"
                           FontFamily="Poppins,Segoe UI"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#1C244B"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ================= 1. HEADER (Logo + Tagline) ================= -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Top"
                    Margin="0,120,0,0"
                    HorizontalAlignment="Center">
            <Image Source="/Assets/logo.png"
                   Width="240"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   MouseDown="Logo_Click"
                   Cursor="Hand"/>

            <TextBlock Text="I N S T A N T   P H O T O   K I O S K" 
                       FontFamily="Poppins" 
                       FontWeight="Bold" 
                       FontSize="15" 
                       Foreground="#FF1C244B" 
                       HorizontalAlignment="Center" 
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- ================= 2. MAIN CONTENT ================= -->
        <Grid Grid.Row="1"
              Margin="0,30,0,60"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title: Choose a Method -->
            <TextBlock Grid.Row="0"
                       Text="Choose a Method"
                       FontFamily="Poppins"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="#1C244B"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <!-- Cards Container (Width 880px, Height 960px matching Camera viewport proportions) -->
            <Grid Grid.Row="1" Width="880" Height="960" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Card: Take Live Photo -->
                <Button Grid.Column="0"
                        Style="{StaticResource CardButtonStyle}"
                        Click="TakeLivePhoto_Click">
                    <Grid Margin="20,60,20,60">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Camera Lens Icon -->
                        <Image Grid.Row="0"
                               Source="/Assets/CameraIcon.png"
                               Width="320"
                               Height="320"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <!-- Label -->
                        <TextBlock Grid.Row="1"
                                   Text="Take Live Photo"
                                   FontFamily="Poppins"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="#FF1C244B"
                                   HorizontalAlignment="Center"
                                   Margin="0,40,0,10"/>
                    </Grid>
                </Button>

                <!-- Right Card: Upload from Phone -->
                <Button Grid.Column="2"
                        Style="{StaticResource CardButtonStyle}"
                        Click="UploadFromPhone_Click">
                    <Grid Margin="20,60,20,60">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Upload Icon -->
                        <Image Grid.Row="0"
                               Source="/Assets/UploadFromPhoto.png"
                               Width="320"
                               Height="320"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <!-- Label -->
                        <TextBlock Grid.Row="1"
                                   Text="Upload from Phone"
                                   FontFamily="Poppins"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="#FF1C244B"
                                   HorizontalAlignment="Center"
                                   Margin="0,40,0,10"/>
                    </Grid>
                </Button>
            </Grid>
        </Grid>

        <!-- Overlay Grid for Terms and Conditions Popup -->
        <Grid x:Name="TermsPopupOverlay" 
              Grid.Row="0"
              Grid.RowSpan="2"
              Background="#99000000" 
              Visibility="Collapsed">
            <Border Width="500" Height="250" Background="White" CornerRadius="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="4" Color="#000000" Opacity="0.3"/>
                </Border.Effect>
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Title -->
                        <RowDefinition Height="*"/>
                        <!-- Subtext -->
                        <RowDefinition Height="Auto"/>
                        <!-- Buttons -->
                    </Grid.RowDefinitions>

                    <TextBlock Text="We care about your privacy"
                               FontFamily="Poppins"
                               FontWeight="Bold"
                               FontSize="20"
                               Foreground="#1C244B"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,8"/>

                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               FontFamily="Poppins"
                               FontSize="14.5"
                               Foreground="#555555"
                               Margin="0,2,0,0">
                        <Run Text="Please read the "/>
                        <Hyperlink x:Name="TermsLink" Click="TermsLink_Click" TextDecorations="None" Foreground="#3E63FF" FontWeight="Bold">
                            <Run Text="Terms &amp; Conditions"/>
                        </Hyperlink>
                    </TextBlock>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource PopupCancelButtonStyle}"
                                Click="CancelTerms_Click">
                            <TextBlock Text="Cancel"
                                       FontFamily="Poppins"
                                       FontWeight="SemiBold"
                                       FontSize="16"
                                       Foreground="#3E63FF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>

                        <Button Grid.Column="2"
                                Style="{StaticResource PopupAcceptButtonStyle}"
                                Click="AcceptTerms_Click">
                            <TextBlock Text="Accept"
                                       FontFamily="Poppins"
                                       FontWeight="SemiBold"
                                       FontSize="16"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>