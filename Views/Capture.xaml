<Page x:Class="kuboPix.Views.Capture"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      Title="Capture"
      Background="White"
      FontFamily="Poppins,Segoe UI"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      >

    <Page.Resources>

        <!-- Common Button Style -->
        <Style x:Key="KioskButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="22">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.88"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.72"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Terms and Conditions Popup Cancel Button Style -->
        <Style x:Key="PopupCancelButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="White"
                                BorderBrush="#3E63FF"
                                BorderThickness="2"
                                CornerRadius="12">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F0F4FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E2E9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Terms and Conditions Popup Accept Button Style -->
        <Style x:Key="PopupAcceptButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="#3E63FF"
                                CornerRadius="12">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Logo/Header -->
            <RowDefinition Height="*"/>    <!-- Main Content (Card) -->
        </Grid.RowDefinitions>

        <!-- ================= 1. HEADER (Logo + Tagline) ================= -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Top"
                    Margin="0,80,0,0"
                    HorizontalAlignment="Center">
            <Image Source="/Assets/logo.png"
                   Width="270"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   MouseDown="Logo_Click"
                   Cursor="Hand"/>

            <TextBlock Margin="0,15,0,0"
                       Text="INSTANT PHOTO KIOSK"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#1C244B"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- ================= 2. CARD (Middle Content) ================= -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,20">
            <Border Width="500"
                    MaxHeight="1200"
                    Background="White"
                    BorderBrush="#E8ECEF"
                    BorderThickness="1.5"
                    CornerRadius="36"
                    HorizontalAlignment="Center">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="30"
                                      ShadowDepth="8"
                                      Color="#000000"
                                      Opacity="0.08"/>
                </Border.Effect>

                <Grid Margin="45,110,45,110">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Illustration -->
                        <RowDefinition Height="100"/>
                        <!-- Spacer -->
                        <RowDefinition Height="Auto"/>
                        <!-- Title -->
                        <RowDefinition Height="90"/>
                        <!-- Spacer -->
                        <RowDefinition Height="Auto"/>
                        <!-- Button 1 -->
                        <RowDefinition Height="50"/>
                        <!-- Spacer -->
                        <RowDefinition Height="Auto"/>
                        <!-- Button 2 -->
                    </Grid.RowDefinitions>

                    <!-- Illustration -->
                    <Image Grid.Row="0"
                           Width="300"
                           Source="/Assets/KuboPix.png"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Title -->
                    <TextBlock Grid.Row="2"
                               Text="Choose a Method"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="#1C244B"
                               HorizontalAlignment="Center"/>

                    <!-- Take Live Photo -->
                    <Button Grid.Row="4"
                            Style="{StaticResource KioskButtonStyle}"
                            Background="#5671FF"
                            Click="TakeLivePhoto_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="22" Background="White" Margin="0,0,16,0" VerticalAlignment="Center">
                                <Image Source="/Assets/CameraIcon.png"
                                       Width="24"
                                       Height="24"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="TAKE LIVE PHOTO"
                                       FontSize="17.5"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Upload -->
                    <Button Grid.Row="6"
                            Style="{StaticResource KioskButtonStyle}"
                            Background="#404040"
                            Click="UploadFromPhone_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="22" Background="White" Margin="0,0,16,0" VerticalAlignment="Center">
                                <Image Source="/Assets/UploadFromPhoto.png"
                                       Width="24"
                                       Height="24"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="UPLOAD FROM PHONE"
                                       FontSize="17.5"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Overlay Grid for Terms and Conditions Popup -->
        <Grid x:Name="TermsPopupOverlay" 
              Grid.Row="0"
              Grid.RowSpan="2"
              Background="#99000000" 
              Visibility="Collapsed">
            <Border Width="500" Height="250" Background="White" CornerRadius="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="4" Color="#000000" Opacity="0.3"/>
                </Border.Effect>
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Title -->
                        <RowDefinition Height="*"/>
                        <!-- Subtext -->
                        <RowDefinition Height="Auto"/>
                        <!-- Buttons -->
                    </Grid.RowDefinitions>

                    <TextBlock Text="We care about your privacy"
                               FontFamily="Poppins"
                               FontWeight="Bold"
                               FontSize="20"
                               Foreground="#1C244B"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,8"/>

                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               FontFamily="Poppins"
                               FontSize="14.5"
                               Foreground="#555555"
                               Margin="0,2,0,0">
                        <Run Text="Please read the "/>
                        <Hyperlink x:Name="TermsLink" Click="TermsLink_Click" TextDecorations="None" Foreground="#3E63FF" FontWeight="Bold">
                            <Run Text="Terms &amp; Conditions"/>
                        </Hyperlink>
                    </TextBlock>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource PopupCancelButtonStyle}"
                                Click="CancelTerms_Click">
                            <TextBlock Text="Cancel"
                                       FontFamily="Poppins"
                                       FontWeight="SemiBold"
                                       FontSize="16"
                                       Foreground="#3E63FF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>

                        <Button Grid.Column="2"
                                Style="{StaticResource PopupAcceptButtonStyle}"
                                Click="AcceptTerms_Click">
                            <TextBlock Text="Accept"
                                       FontFamily="Poppins"
                                       FontWeight="SemiBold"
                                       FontSize="16"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>