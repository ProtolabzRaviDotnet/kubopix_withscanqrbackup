<Window x:Class="MiniApp.Views.ConfirmExitDialogForUnderMaintenancePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Height="360" Width="430">

    <Border CornerRadius="18" Background="White" Padding="20" BorderBrush="#CCCCCC" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" >

            <!-- Icon Circle -->
            <Grid Width="70" Height="70" HorizontalAlignment="Center">
                <Ellipse Fill="#F3F3F3">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#000"
                                          BlurRadius="15"
                                          ShadowDepth="0"
                                          Opacity="0.25"/>
                    </Ellipse.Effect>
                </Ellipse>

                <Image Source="/Assets/logout.png"
                       Width="28" Height="28"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
            </Grid>

            <!-- Title -->
            <TextBlock Text="Exit Kiosk?"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#333"
                       Margin="0,15,0,5"
                       HorizontalAlignment="Center"/>

            <!-- Subtitle -->
            <TextBlock Text="Are you sure you want to exit from this kiosk?"
                       FontSize="14"
                       Foreground="#777"
                       TextAlignment="Center"
                       Margin="0,0,0,15"/>

            <!-- Password Input -->
            <Grid Margin="20,0,20,10">
                <Border x:Name="PasswordBorder"
                        CornerRadius="10"
                        BorderBrush="#CCC"
                        BorderThickness="1"
                        Background="#FAFAFA"
                        Padding="10">

                    <Grid>
                        <!-- PasswordBox -->
                        <PasswordBox x:Name="PasswordBox"
                                     FontSize="14"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>

                        <!-- Placeholder -->
                        <TextBlock x:Name="PasswordPlaceholder"
                                   Text="Enter your password"
                                   Foreground="#AAA"
                                   FontSize="14"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Hint Text -->
            <TextBlock Text="Enter your password to confirm Exit"
                       FontSize="15"
                       Foreground="#999"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0">

                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Width="120" Height="40"
                        Margin="0,0,10,0"
                        Background="#EEE"
                        BorderBrush="#DDD"
                        BorderThickness="1"
                        Foreground="#444"
                        Click="Cancel_Click"/>

                <Button x:Name="ExitButton"
                        Content="Exit"
                        Width="120" Height="40"
                        Background="#E53935"
                        Foreground="White"
                        BorderThickness="0"
                        TouchDown="OnButtonTouchDown"
                        Focusable="True"
                        Click="Exit_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
