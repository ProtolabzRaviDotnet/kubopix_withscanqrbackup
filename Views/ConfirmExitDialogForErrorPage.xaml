<Window x:Class="kuboPix.Views.ConfirmExitDialogForErrorPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter Password"
        Height="300" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">

    <!-- Viewbox + fixed canvas: the dialog is resized to match the UI scale (DialogScaler),
         and this scales the contents to fit. Canvas size = the design size on the Window. -->
    <Viewbox Stretch="Uniform">
      <Grid Width="380" Height="300">
    <Border CornerRadius="12" Background="White"
            BorderBrush="#CCCCCC" BorderThickness="1"
            Padding="15" Margin="0,0,0,79">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="Shop Admin Action"
                       FontWeight="Bold"
                       FontSize="18"
                       Foreground="#5671FF"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <!-- Radio Options -->
            <StackPanel Grid.Row="2" Margin="0,0,0,10" HorizontalAlignment="Left">
                <RadioButton x:Name="rbCloseApp" Content="Close Mini App" 
                              FontSize="15" FontWeight="SemiBold" 
                              IsChecked="True" Margin="3,3"/>
                <RadioButton x:Name="rbMaintenanceMode" Content="Maintenance Mode"
                              FontSize="15" FontWeight="SemiBold"
                              Margin="3,3"/>

            </StackPanel>

            <!-- Password -->
            <Border Grid.Row="3" CornerRadius="5" Background="#F7F7F7" BorderBrush="#CCCCCC" BorderThickness="1">
                <PasswordBox x:Name="PasswordBox"
                              Height="35"
                              FontSize="14"
                              Padding="5"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="Black"/>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Border CornerRadius="6" BorderBrush="#999999" BorderThickness="1" Background="White">
                    <Button  x:Name="CancelButton"
                            Content="Cancel"
                            Width="80" Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#333333"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="Cancel_Click"/>
                </Border>
                <Border CornerRadius="6" Background="#5671FF" Margin="10,0,0,0">
                    <Button x:Name="OkButton" Content="OK"
                             Width="80" Height="32"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             FontWeight="SemiBold"
                             Cursor="Hand"
                             IsDefault="True"
                             Click="Ok_Click"/>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
      </Grid>
    </Viewbox>
</Window>