<Page x:Class="kuboPix.Views.AttractVideoView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:kuboPix.Views"
      mc:Ignorable="d" 
      d:DesignHeight="1366" d:DesignWidth="768"
      Title="AttractVideoView"
      Background="Black"
      Focusable="True"
      FontFamily="Poppins, Segoe UI">

    <Page.Resources>
        <!-- Pulse animation for the Tap Anywhere text -->
        <Storyboard x:Key="PulseAnimation">
            <DoubleAnimation Storyboard.TargetName="TapText" 
                              Storyboard.TargetProperty="Opacity"
                              From="0.3" To="1.0" 
                              Duration="0:0:1.5" 
                              AutoReverse="True" 
                              RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard Storyboard="{StaticResource PulseAnimation}"/>
        </EventTrigger>
    </Page.Triggers>

    <Grid Background="Black" Cursor="Hand">
        <Grid.Triggers>
            <!-- Fade out the Poster Image when the video starts playing -->
            <EventTrigger RoutedEvent="MediaElement.MediaOpened" SourceName="LoopVideo">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="PosterImage"
                                         Storyboard.TargetProperty="Opacity"
                                         To="0.0"
                                         Duration="0:0:0.5"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <!-- Background Video Loop -->
        <MediaElement x:Name="LoopVideo"
                      Stretch="UniformToFill"
                      IsMuted="True" 
                      LoadedBehavior="Manual" 
                      UnloadedBehavior="Stop"
                      IsHitTestVisible="False"
                      MediaEnded="LoopVideo_MediaEnded"
                      MediaFailed="LoopVideo_MediaFailed"/>

        <!-- Poster Image Fallback (Fades out when video starts playing) -->
        <Image x:Name="PosterImage"
               Source="/Assets/0330_PosterImage.png"
               Stretch="UniformToFill"
               Opacity="1.0"
               IsHitTestVisible="False"/>

        <!-- Main Content Overlay -->
        <Grid IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header Area with White-to-Transparent Gradient -->
            <Border x:Name="HeaderBorder" Grid.Row="0" Height="462">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                        <GradientStop Color="#FAFFFFFF" Offset="0.3" />
                        <GradientStop Color="#D0FFFFFF" Offset="0.6" />
                        <GradientStop Color="#00FFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel x:Name="HeaderStack" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,107,0,0">
                    <!-- Logo Image -->
                    <Image x:Name="LogoImage"
                           Source="/Assets/logo.png" 
                           Width="270"
                           Height="85"
                           Stretch="Uniform" 
                           HorizontalAlignment="Center" />
                    
                    <!-- Subtitle Text -->
                    <TextBlock x:Name="SubtitleText"
                               Text="I N S T A N T   P H O T O   K I O S K" 
                               FontFamily="Poppins" 
                               FontWeight="Bold" 
                               FontSize="14"
                               Foreground="#FF1E293B"
                               HorizontalAlignment="Center"
                               Margin="0,25,0,0" />
                </StackPanel>
            </Border>

            <!-- Bottom Prompt Area -->
            <Border x:Name="FooterBorder" Grid.Row="2" Height="284">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                        <GradientStop Color="#33000000" Offset="0.0" />
                        <GradientStop Color="#00000000" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock x:Name="TapText" 
                           Text="Tap Anywhere" 
                           FontFamily="Poppins" 
                           FontWeight="SemiBold" 
                           FontSize="28"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,0,0,85">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="12" 
                                          ShadowDepth="2" 
                                          Direction="270" 
                                          Color="Black" 
                                          Opacity="0.6"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Border>
        </Grid>
    </Grid>
</Page>